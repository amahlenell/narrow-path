# Copy to .env.local and fill in from Supabase → Project Settings → API.
# Both values below are SAFE to expose to the browser (they are protected by
# Row Level Security). Do NOT put a service-role / secret key in this app —
# nothing in it needs one.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY

# Used for the email-confirmation link. http://localhost:3000 locally,
# your Vercel URL in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- PIN lock (optional feature) ----------------------------------------
# 32+ random characters, SERVER ONLY. Generate: openssl rand -base64 48
PIN_COOKIE_SECRET=

# ---- Push notifications (optional feature) --------------------------------
# Generate keys with: npm run vapid
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# ---- Scheduled reminders (optional; ONLY the /api/cron/reminders route uses these) ----
# The service-role key bypasses Row Level Security. Never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=
